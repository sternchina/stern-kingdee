[config]
# 第三方系统登录授权的账套 ID（即数据中心 ID）
X-KDApi-AcctID =

# 第三方系统登录授权的集成用户名称
X-KDApi-UserName =

# 第三方系统登录授权的应用 ID
X-KDApi-AppID =

# 第三方系统登录授权的应用密钥
X-KDApi-AppSec =

# 账套语系，默认 2052=简体中文
X-KDApi-LCID = 2052

# 启用多组织时可配置组织编码
# X-KDApi-OrgNum =

# 若使用代理，可配置代理地址
# X-KDApi-Proxy =

# 服务 URL，按你方实际环境填写，通常以 /K3Cloud/ 结尾
X-KDApi-ServerUrl = https://your-host/K3Cloud/
