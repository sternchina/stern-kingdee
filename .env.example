# 复制本文件为 .env 并填写；敏感登录信息放在 conf.ini，不放这里。

# 官方 Python SDK 登录配置文件路径；默认读取项目根目录 conf.ini
KINGDEE_CONFIG_PATH=conf.ini

# conf.ini 中的节名；默认使用 [config]
KINGDEE_CONFIG_NODE=config

# 可选：指定本地 SDK wheel 路径；未设置时会自动查找项目 .vendor 下的 kingdee*.whl
# KINGDEE_SDK_WHEEL_PATH=.vendor/kingdee.cdp.webapi.sdk-8.2.0-py3-none-any.whl

# 示例查询（main.py query）：ExecuteBillQuery 的 JSON 参数，一行或留空跳过
# KINGDEE_QUERY_JSON={"FormId":"BD_MATERIAL","FieldKeys":"FNumber,FName","FilterString":"","OrderString":"","TopRowCount":0,"StartRow":0,"Limit":10,"SubSystemId":""}

# 示例查看（main.py view）：View 的业务对象标识与参数
# KINGDEE_VIEW_FORM_ID=QM_QualityStd
# KINGDEE_VIEW_PARA_JSON={"CreateOrgId":0,"Number":"","Id":"","IsSortBySeq":"false"}
